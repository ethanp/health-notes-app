# health_notes .env: copy to .env (gitignored, bundled as a Flutter asset).
# Every app's .env.example has this shape: the shared sync keys, then the
# keys only this app reads.
#
# Home-server hosts come from ethan_sync/home_server.env. Set SERVER_HOST_LAN /
# SERVER_HOST_TAILSCALE here only to point this app at its own backend.

# Signs this app's PowerSync JWTs. The server's HEALTH_NOTES_POWERSYNC_JWT_KEY is
# its base64 form; infra/provision-sync-app.sh writes both.
POWERSYNC_JWT_SECRET=
